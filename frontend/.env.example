# Backend API Configuration
# --------------------------
# Base URL for the backend API server
# For local development: http://localhost:5000
# For production: https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:5000

# API Endpoints (Optional - derived from base URL)
# -------------------------------------------------
# These are constructed automatically from VITE_API_BASE_URL
# Uncomment and customize if your API structure differs
# VITE_QUESTIONS_ENDPOINT=/api/questions
# VITE_SESSIONS_ENDPOINT=/api/sessions
# VITE_EVALUATE_ENDPOINT=/api/evaluate
# VITE_SUMMARY_ENDPOINT=/api/summary

# Environment
# -----------
# Set to 'development' or 'production'
# In Vite, this is automatically set based on the build mode
# MODE=development

# Feature Flags (Optional)
# -------------------------
# Enable/disable features during development
# VITE_ENABLE_AUDIO_RECORDING=true
# VITE_ENABLE_AI_EVALUATION=true
# VITE_ENABLE_SPEECH_SYNTHESIS=true

# Analytics (Optional)
# ---------------------
# Add analytics tracking IDs for production
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Debug Mode (Optional)
# ---------------------
# Enable verbose logging in development
# VITE_DEBUG=false
