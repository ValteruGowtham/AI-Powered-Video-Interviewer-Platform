# MongoDB Configuration
# -------------------
# MongoDB Atlas connection string (recommended) or local MongoDB URL
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
# Get your connection string from: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/ai-mock-interviewer

# OpenAI API Configuration
# ------------------------
# Your OpenAI API key for GPT-3.5 Turbo evaluation
# Get your API key from: https://platform.openai.com/api-keys
# IMPORTANT: Keep this key secret and never commit to version control
OPENAI_API_KEY=sk-your_openai_api_key_here

# Server Configuration
# --------------------
# Port number for the Express server to run on
# Default: 5000
PORT=5000

# Node Environment
# ----------------
# Set to 'development' for local development or 'production' for deployment
# Affects error messages and logging verbosity
NODE_ENV=development

# CORS Configuration (Optional)
# ------------------------------
# Allowed origins for Cross-Origin Resource Sharing
# Default: http://localhost:5173 (Vite development server)
# For production, set to your frontend domain
# CORS_ORIGIN=http://localhost:5173

# File Upload Configuration (Optional)
# -------------------------------------
# Maximum file size for audio uploads in megabytes
# Default: 10MB
# MAX_FILE_SIZE=10

# Audio file storage directory (relative to backend root)
# Default: uploads
# UPLOAD_DIR=uploads

# Rate Limiting (Optional)
# ------------------------
# Maximum requests per IP address within the time window
# Default: 100 requests per 15 minutes
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
